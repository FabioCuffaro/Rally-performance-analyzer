# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/

# Environment variables
.env
.env.local

# Data raw (JSON originales -- regenerables, no subir)
data/raw/*.json
data/raw/*.csv

# eWRC cache (HTML cacheado localmente, no subir al repo)
data/raw/ewrc/

# Data processed -- los CSVs se suben al repo para el deploy
# Si quieres excluirlos, descomenta:
# data/processed/*.csv
# data/processed/*.parquet

# Keep gitkeep placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Repomix (herramienta de analisis, no subir)
repomix-output.md
repomix-output*.md

# Documentacion interna (uso personal, no subir al repo)
docs/
docs-bloque-*.md

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets
.streamlit/secrets.toml

# Frontend — Node / build artifacts
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
frontend/*.tsbuildinfo
