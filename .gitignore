# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/

# Environment variables
.env
.env.local

# Data raw (JSON originales -- regenerables, no subir)
data/raw/*.json
data/raw/*.csv

# eWRC cache (HTML cacheado localmente, no subir al repo)
data/raw/ewrc/

# Data processed -- los CSVs de mock SI se suben al repo para el deploy
# Si quieres excluirlos, descomenta las siguientes lineas:
# data/processed/*.csv
# data/processed/*.parquet

# Keep the .gitkeep placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Repomix output (herramienta de analisis de codigo, no subir al repo)
repomix-output.md
repomix-output*.md

# Documentacion interna del proyecto (uso personal, no subir al repo)
# El README.md es el unico documento publico
docs/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets (contienen URLs y credenciales de produccion)
.streamlit/secrets.toml
